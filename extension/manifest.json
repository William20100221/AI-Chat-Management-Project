{
  "manifest_version": 3,
  "name": "AI Chat Manager for Claude",
  "version": "0.3.0",
  "description": "Shows your claude.ai chats (titles, dates, and whether Claude is replying) in the AI Chat Manager app on this computer. Nothing leaves your computer.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "AI Chat Manager",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-chat-manager@local",
      "strict_min_version": "128.0"
    }
  }
}
