{
  "name": "ai-chat-manager",
  "productName": "AI Chat Manager",
  "version": "0.6.0",
  "description": "A sticky note for your AI chats across platforms (Claude, ChatGPT): see which chats and sessions need you.",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist:win": "electron-packager . \"AI Chat Manager\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"^/(test|dist|scripts|extension)($|/)\" --extra-resource=extension"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5"
  }
}
